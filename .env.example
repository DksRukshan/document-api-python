# Google Antigravity SDK Authentication
# Default: Gemini API (recommended) — create a key at https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# Optional: override the default Antigravity SDK model (leave blank to use SDK default)
# ANTIGRAVITY_MODEL=

# Optional: Vertex AI / Gemini Enterprise Agent Platform
# ANTIGRAVITY_BACKEND=gemini   # gemini | vertex | ollama | litert
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Local model server (Ollama / LM Studio) or LiteRT model path
# LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
# LOCAL_OPENAI_MODEL=gemma4:26b
# LITERT_MODEL_PATH=~/.litert-lm/models/gemma4-26b/model.litertlm

